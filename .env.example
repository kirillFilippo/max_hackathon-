# ─── Обязательное ────────────────────────────────────────────────────────────
# Токен бота MAX. Получите у @MasterBot в MAX. НЕ коммитьте реальный токен.
BOT_TOKEN=replace_me_with_real_bot_token

# Строка подключения PostgreSQL. Состояние бота (события, участники, списки
# покупок, расчёты, профили с реквизитами и черновики мастеров) хранится в БД,
# поэтому переживает перезапуск бота и деплой.
# В docker compose хост — имя сервиса postgres, логин и пароль см. ниже.
DATABASE_URL=postgres://dosug:dosug@localhost:5432/dosug
DATABASE_POOL_SIZE=10
# true — если БД требует TLS (например, внешний кластер)
DATABASE_SSL=false

# ─── Режим получения обновлений ──────────────────────────────────────────────
# polling — long polling, удобно для локального запуска и проверки в MAX
# webhook — приём обновлений по HTTPS (рекомендуется платформой для production)
BOT_MODE=webhook

# Публичный HTTPS-адрес вебхука. При схеме «бот дома + туннель на VPS» это
# маршрут Cloudflare на тот же хост, что и мини-приложение.
WEBHOOK_URL=https://minimax.zmeyka.dev/max/webhook
WEBHOOK_PATH=/max/webhook
WEBHOOK_PORT=8080
WEBHOOK_SECRET=change_me_webhook_secret
# Как часто проверять, что подписка на вебхук жива. MAX теряет подписку, если
# адрес был недоступен (домашний интернет, туннель), — бот оформит её заново.
WEBHOOK_CHECK_SECONDS=60

# ─── Время ───────────────────────────────────────────────────────────────────
# Часовой пояс, в котором организатор вводит и видит даты
APP_TZ=Europe/Moscow
# Ник бота в MAX (без @). Если пусто — берётся из GET /me
BOT_USERNAME=

# ─── Мини-приложение «Вопросы участникам» (опционально) ──────────────────────
# Публичный HTTPS-адрес, по которому MAX откроет мини-приложение. Если пусто —
# функция выключена, вопросы собираются прямо в чате.
# Вебхук и мини-приложение живут на одном порту (MINIAPP_PORT), поэтому наружу
# достаточно одного маршрута Cloudflare: minimax.zmeyka.dev -> http://localhost:8090
MINIAPP_URL=https://minimax.zmeyka.dev
# Локальный порт HTTP-сервера мини-приложения внутри контейнера/машины
MINIAPP_PORT=8090
# 1 — разрешить открывать анкету без подписи запуска (только для локальной отладки!).
# В проде оставьте 0: иначе любой сможет прислать ответы от чужого имени.
MINIAPP_DEV=0

# ─── Сертификаты (опционально) ───────────────────────────────────────────────
# Корневой сертификат (Russian Trusted Root CA / Минцифры) НЕ обязателен:
# без него бот использует системное хранилище Node. Если платформа MAX отдаёт
# ошибку TLS, положите файл в ./certs/russian-trusted-root-ca.pem — бот сам
# перезапустится с NODE_EXTRA_CA_CERTS. Путь можно задать явно этой переменной.
# MAX_CA_CERT_PATH=./certs/russian-trusted-root-ca.pem

# ─── Напоминания ─────────────────────────────────────────────────────────────
# За сколько часов до начала просить подтверждение статуса
REMINDER_CONFIRM_HOURS=48
# За сколько часов до начала присылать финальное напоминание с деталями
REMINDER_FINAL_HOURS=1
# Как часто планировщик проверяет, кому пора напомнить (секунды)
REMINDER_TICK_SECONDS=60
# Через сколько часов после начала событие закрывается автоматически.
EVENT_STALE_HOURS=3
# Сколько живёт незавершённый черновик мастера
SESSION_TTL_HOURS=24

# ─── Прочее ──────────────────────────────────────────────────────────────────
# debug, info, warn, error
LOG_LEVEL=info

# Хранилище: auto — PostgreSQL с запасным режимом в памяти (по умолчанию),
# postgres — строго база, memory — вообще без базы (демо).
STORAGE_MODE=auto
STORAGE_CHECK_SECONDS=30
OFFLINE_STATE_PATH=data/offline-state.json

# Отладочные команды: /debugcreateevent (наполнить событие людьми) и
# /debugreceiveevent (попасть в такое событие участником). В проде выключить.
DEBUG_COMMANDS=0

# ─── Только для docker compose: параметры сервиса postgres ───────────────────
POSTGRES_USER=dosug
POSTGRES_PASSWORD=dosug
POSTGRES_DB=dosug
# Порт БД на хосте (нужен, если подключаетесь к базе снаружи контейнера)
POSTGRES_PORT=5432
