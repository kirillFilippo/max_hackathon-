# Переменные для сервера/локального запуска по схеме «бот дома/на VPS + туннель Cloudflare».
# Это ОБРАЗЕЦ: рабочее значения держим в .env (он в .gitignore) или в GitHub Secrets.
#
# Схема: MAX --webhook--> https://minimax.zmeyka.dev --Cloudflare--> VPS:8090
#        --обратный SSH-туннель--> локальный порт 8090 (бот + мини-приложение в одном процессе)

BOT_TOKEN=<токен от @MasterBot>
BOT_MODE=webhook
# Публичный адрес вебхука: путь /max/webhook, хост тот же, что у мини-приложения
WEBHOOK_URL=https://minimax.zmeyka.dev/max/webhook
WEBHOOK_PATH=/max/webhook
WEBHOOK_PORT=8080
# Длинная случайная строка; MAX шлёт её в заголовке x-max-bot-api-secret
WEBHOOK_SECRET=<openssl rand -hex 24>

# Мини-приложение (конструктор вопросов и анкеты) — на том же порту, что и вебхук
MINIAPP_URL=https://minimax.zmeyka.dev
MINIAPP_PORT=8090

# База данных: локальный Postgres или домашний через туннель
DATABASE_URL=postgres://dosug:<пароль>@127.0.0.1:5432/dosug
APP_TZ=Europe/Moscow
BOT_USERNAME=t585_hakaton_max_bot
LOG_LEVEL=info
